# DataGuard Environment Configuration
# Copy this to .env and fill in values

# ── Application ──
APP_NAME=DataGuard
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──
DATABASE_URL=postgresql+asyncpg://dataguard:dataguard@localhost:5432/dataguard
DATABASE_URL_SYNC=postgresql://dataguard:dataguard@localhost:5432/dataguard

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_SECONDARY=gpt-4o
OPENAI_MAX_BUDGET_USD=5.00

# ── File Storage ──
UPLOAD_DIR=storage/uploads
VERSION_DIR=storage/versions
MAX_FILE_SIZE_MB=100

# ── Security ──
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
API_KEY=  # Optional API key for production

# ── LLM Config ──
LLM_CACHE_ENABLED=true
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS_PER_CALL=2048

# ── Autonomy Gate Thresholds ──
THRESHOLD_MAX_CONFLICT=0.3
THRESHOLD_MAX_IGNORANCE=0.4
THRESHOLD_BELIEF_ERROR=0.5
THRESHOLD_BELIEF_CLEAN=0.5
